# Copy this file to .env and fill in the REQUIRED values.
#   cp .env.example .env        (PowerShell: Copy-Item .env.example .env)

# --- LLM access (REQUIRED) -------------------------------------------------
# Portkey API key (https://app.portkey.ai). REQUIRED: the app refuses to start without it.
# Every LLM call (orchestrator, social listening, synthesis, DeepEval judge) goes through the
# Portkey gateway; there is no fallback to calling Groq directly.
PORTKEY_API_KEY=your-portkey-api-key

# How Portkey reaches Groq -- pick ONE:
#  (a) Saved integration (Portkey Model Catalog, Groq key stored in Portkey). Required when the
#      workspace enforces "block inline config". Set the integration's slug, e.g.:
# PORTKEY_PROVIDER=@groq
#  (b) Inline provider (default): Portkey forwards this Groq key (https://console.groq.com/keys).
GROQ_API_KEY=your-groq-api-key
# Optional: a saved Portkey config slug (e.g. gateway retries/fallbacks), referenced as pc-...
# PORTKEY_CONFIG=

# --- Models (Groq, via Portkey) ---------------------------------------------
# llama-3.1-8b-instant / llama-3.3-70b-versatile were retired for free & developer
# Groq accounts on 2026-08-16, so the demo defaults to the gpt-oss replacements.
SMALL_MODEL=openai/gpt-oss-20b
LARGE_MODEL=openai/gpt-oss-120b
JUDGE_MODEL=openai/gpt-oss-120b

# --- Neo4j ------------------------------------------------------------------
# Host scripts use localhost; docker-compose overrides this to bolt://neo4j:7687 for the app container.
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=agrigraph-demo-pw

# Optional host-port overrides for docker-compose (defaults 7474 / 7687 / 8000). If you change
# NEO4J_BOLT_PORT, also change NEO4J_URI above to match, e.g. bolt://localhost:17687.
# NEO4J_HTTP_PORT=17474
# NEO4J_BOLT_PORT=17687
# APP_PORT=8001

# --- LanceDB ----------------------------------------------------------------
LANCEDB_PATH=./data/lancedb

# --- DeepEval (offline evaluation only) -------------------------------------
DEEPEVAL_TELEMETRY_OPT_OUT=1
DEEPEVAL_NO_INSPECT_PROMPT=1
# Optional: set to push eval runs to the Confident AI dashboard. Everything works locally without it.
# CONFIDENT_API_KEY=
